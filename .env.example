# The local server does not need keys. Never enter a wallet seed/private key.
HOST=127.0.0.1
PORT=4173
# Use your externally reachable HTTPS origin for portable checkpoint URLs.
PUBLIC_ORIGIN=http://localhost:4173
CHECKPOINT_DIR=.storage/checkpoints
# Optional; used ONLY by the read-only verification script.
SEPOLIA_RPC_URL=
